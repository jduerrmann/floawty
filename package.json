{
  "name": "floawty",
  "version": "0.1.0",
  "private": true,
  "description": "Watch streaming services in a small always-on-top overlay",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build:ui": "vite build && node scripts/build-page-scripts.mjs",
    "build": "tauri build --no-bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:adapters": "node scripts/build-page-scripts.mjs && playwright test --project adapter",
    "smoke": "playwright test --project app",
    "measure": "playwright test -c tests/measure",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:adapters && npm run lint:rust && npm run test:rust",
    "verify": "npm run check && npm run build && npm run smoke"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "~2.12.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
