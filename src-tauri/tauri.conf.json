{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "floawty",
  "version": "0.1.0",
  "identifier": "io.github.floawty",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "floawty",
        "width": 480,
        "height": 270,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking",
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "minWidth": 240,
        "minHeight": 135
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
