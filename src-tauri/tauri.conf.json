{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "floawty",
  "version": "0.1.0-rc.1",
  "identifier": "io.github.floawty",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "floawty",
        "width": 480,
        "height": 270,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "minWidth": 240,
        "minHeight": 135
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3NDc4MTYyNzk0MzYxMEUKUldRT1lVTjVZb0ZIQjRlc1BZOXZ6NXJvQkg2cFM3ZDQrZTdINEJONjNkeXY1MHd0Qk1xcGg4dnMK",
      "endpoints": ["https://github.com/jduerrmann/floawty/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "floawty",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
